# This file belongs on the teacher-controlled backend computer, never in the APK.
# Put a newly issued key here only after revoking any key exposed in shared documents.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-flash-0731
NVIDIA_NIM_TIMEOUT_MS=8000

# Luna is the primary provider. OPENAI_API_KEY remains supported as an alias.
LUNA_API_KEY=
LUNA_MODEL=gpt-5.6-luna
LUNA_TIMEOUT_MS=10000

# Bounded microphone transcription for the authenticated temi client.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSCRIPTION_FALLBACK_MODEL=whisper-1
TRANSCRIPTION_TIMEOUT_MS=30000
MAX_TRANSCRIPTION_DURATION_MS=20000

# Legacy names are accepted for migration, but new deployments should use LUNA_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

HOST=0.0.0.0
PORT=8787
DATA_FILE=./data/items.json
STAFF_DIRECTORY_FILE=./data/staff-directory.json

# Required for PUT/DELETE /api/v1/admin/items/:id.
ADMIN_TOKEN=

# Required. The temi app must send the same Bearer token.
# Generate a long random value and keep it out of source control and shared folders.
# This is only a classroom-network access gate; it is not a substitute for TLS.
TEMI_CLIENT_TOKEN=

# If both providers are unavailable, return a deterministic explanation made
# only from teacher-entered data.
FALLBACK_ON_PROVIDER_ERROR=true
FALLBACK_ON_OPENAI_ERROR=true
